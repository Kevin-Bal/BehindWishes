# Copier en .env.local et remplir avec la config de l'app Web Firebase
# (Console Firebase > Paramètres du projet > Vos applications > SDK setup).
# Ces valeurs sont publiques par conception : la sécurité repose sur les règles Firestore.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
