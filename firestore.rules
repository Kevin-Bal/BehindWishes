rules_version = '2';

// Règles Firestore — la sécurité de l'app repose entièrement sur ce fichier
// (site statique, aucun serveur). Voir docs/SPEC.md, sections Confidentialité et Architecture.
// Toute modification doit garder tests/firestore.rules.test.ts au vert (`npm run test:rules`).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isString(value, minSize, maxSize) {
      return value is string && value.size() >= minSize && value.size() <= maxSize;
    }

    // Seuls les champs modifiés par la requête, comparés au document existant.
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Diagnostic du Lot 0 : chaque appareil (uid anonyme) lit et écrit son propre document.
    match /healthchecks/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // ── Groupes ────────────────────────────────────────────────────────────
    // L'identifiant du groupe EST son code d'accès : le connaître donne accès au contenu,
    // et aucune requête ne permet de lister les groupes.
    match /groups/{code} {
      function validGroup(data) {
        return data.keys().hasOnly(['name', 'createdAt'])
          && isString(data.name, 1, 60);
      }

      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && code.matches('^[A-HJ-NP-Z2-9]{8}$')
        && validGroup(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn()
        && changedKeys().hasOnly(['name'])
        && validGroup(request.resource.data);
      allow delete: if false;

      function groupExistsAfter() {
        return existsAfter(/databases/$(database)/documents/groups/$(code));
      }

      // ── Niveau 2 de confidentialité (lot 6) ──────────────────────────────
      // Chaque appareil (uid anonyme) déclare le membre qu'il incarne dans
      // `sessions/{uid}`. `me()` échoue (donc refuse) si l'appareil n'a pas de session.
      // Limite assumée : changer d'identité (« Ce n'est pas moi ») met à jour la session.
      function me() {
        return get(/databases/$(database)/documents/groups/$(code)/sessions/$(request.auth.uid)).data.memberId;
      }

      match /sessions/{uid} {
        allow get: if signedIn() && request.auth.uid == uid;
        allow list: if false;
        allow create, update: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['memberId', 'updatedAt'])
          && request.resource.data.memberId is string
          && exists(/databases/$(database)/documents/groups/$(code)/members/$(request.resource.data.memberId))
          && request.resource.data.updatedAt == request.time;
        allow delete: if signedIn() && request.auth.uid == uid;
      }

      // ── Membres (A3, B1, B2) ─────────────────────────────────────────────
      match /members/{memberId} {
        function validMember(data) {
          return data.keys().hasAll(['name', 'color', 'archived', 'createdAt'])
            && data.keys().hasOnly(['name', 'color', 'emoji', 'archived', 'createdAt'])
            && isString(data.name, 1, 30)
            && data.color is string && data.color.matches('^#[0-9a-fA-F]{6}$')
            && (!('emoji' in data) || isString(data.emoji, 1, 16))
            && data.archived is bool;
        }

        allow read: if signedIn();
        allow create: if signedIn()
          && groupExistsAfter()
          && validMember(request.resource.data)
          && request.resource.data.archived == false
          && request.resource.data.createdAt == request.time;
        allow update: if signedIn()
          && changedKeys().hasOnly(['name', 'color', 'emoji', 'archived'])
          && validMember(request.resource.data);
        // Pas de suppression définitive : on archive (l'historique est conservé).
        allow delete: if false;
      }

      // ── Évènements (C1, C2, C3) ──────────────────────────────────────────
      match /events/{eventId} {
        function validEvent(data) {
          return data.keys().hasAll(['title', 'type', 'date', 'beneficiaryIds', 'participantIds',
                                     'archived', 'createdBy', 'createdAt'])
            && data.keys().hasOnly(['title', 'type', 'date', 'beneficiaryIds', 'participantIds',
                                    'archived', 'createdBy', 'createdAt'])
            && isString(data.title, 1, 80)
            && data.type in ['noel', 'anniversaire', 'autre']
            && (data.date == null || data.date is timestamp)
            && data.beneficiaryIds is list
            && data.beneficiaryIds.size() >= 1 && data.beneficiaryIds.size() <= 100
            && data.participantIds is list
            && data.participantIds.size() <= 100
            // Tout bénéficiaire est aussi participant.
            && data.participantIds.hasAll(data.beneficiaryIds)
            && data.archived is bool;
        }

        allow read: if signedIn();
        allow create: if signedIn()
          && validEvent(request.resource.data)
          && request.resource.data.archived == false
          && request.resource.data.createdAt == request.time
          && exists(/databases/$(database)/documents/groups/$(code)/members/$(request.resource.data.createdBy));
        allow update: if signedIn()
          && changedKeys().hasOnly(['title', 'type', 'date', 'beneficiaryIds', 'participantIds',
                                    'archived'])
          && validEvent(request.resource.data);
        // Seul le créateur supprime (C3).
        allow delete: if signedIn() && resource.data.createdBy == me();

        // ── Souhaits (D1 à D4) ───────────────────────────────────────────
        // Un souhait ne contient JAMAIS d'information de réservation (voir `claims`).
        match /wishes/{wishId} {
          function validWish(data) {
            return data.keys().hasAll(['beneficiaryId', 'title', 'deleted', 'createdAt',
                                       'updatedAt'])
              && data.keys().hasOnly(['beneficiaryId', 'title', 'url', 'description',
                                      'priceEstimate', 'priority', 'deleted', 'createdAt',
                                      'updatedAt', 'contentUpdatedAt', 'imageUrl'])
              && (!('imageUrl' in data) || (isString(data.imageUrl, 1, 1000)
                                            && data.imageUrl.matches('^https://.+')))
              && (!('contentUpdatedAt' in data) || data.contentUpdatedAt is timestamp)
              && isString(data.title, 1, 120)
              && (!('url' in data) || (isString(data.url, 1, 500)
                                       && data.url.matches('^https?://.+')))
              && (!('description' in data) || isString(data.description, 1, 500))
              && (!('priceEstimate' in data) || (data.priceEstimate is number
                                                 && data.priceEstimate >= 0
                                                 && data.priceEstimate <= 100000))
              && (!('priority' in data) || data.priority in [1, 2, 3])
              && data.deleted is bool;
          }

          function event() {
            return get(/databases/$(database)/documents/groups/$(code)/events/$(eventId)).data;
          }

          allow read: if signedIn();
          allow create: if signedIn()
            && validWish(request.resource.data)
            && request.resource.data.deleted == false
            && request.resource.data.createdAt == request.time
            && request.resource.data.updatedAt == request.time
            && request.resource.data.beneficiaryId in event().beneficiaryIds
            // Seul le bénéficiaire écrit sur sa liste.
            && request.resource.data.beneficiaryId == me();
          allow update: if signedIn()
            && resource.data.beneficiaryId == me()
            && changedKeys().hasOnly(['title', 'url', 'description', 'priceEstimate',
                                      'priority', 'deleted', 'updatedAt', 'contentUpdatedAt',
                                      'imageUrl'])
            && (!('contentUpdatedAt' in changedKeys())
                || request.resource.data.contentUpdatedAt == request.time)
            && request.resource.data.updatedAt == request.time
            && validWish(request.resource.data);
          // Suppression logique uniquement (`deleted = true`) : le réservant doit être prévenu.
          allow delete: if false;
        }

        // ── Réservations (E1 à E5) ───────────────────────────────────────
        // Stockées à part des souhaits ; identifiant `{wishId}_{memberId}` : une réservation
        // par personne et par souhait, plusieurs personnes possibles sur un même souhait.
        // Niveau 2 : l'appareil du bénéficiaire ne peut pas lire les réservations de sa liste,
        // et seul le réservant crée, modifie ou annule sa réservation.
        match /claims/{claimId} {
          function event() {
            return get(/databases/$(database)/documents/groups/$(code)/events/$(eventId)).data;
          }

          function wish(wishId) {
            return get(/databases/$(database)/documents/groups/$(code)/events/$(eventId)/wishes/$(wishId)).data;
          }

          // Deux formes que les requêtes peuvent prouver : « mes réservations »
          // (claimedBy == moi) ou « la liste d'un autre » (beneficiaryId != moi).
          allow read: if signedIn()
            && (resource.data.claimedBy == me() || resource.data.beneficiaryId != me());
          allow create: if signedIn()
            && request.resource.data.claimedBy == me()
            && request.resource.data.keys().hasOnly(['wishId', 'beneficiaryId', 'claimedBy',
                                                     'status', 'claimedAt', 'updatedAt'])
            && request.resource.data.keys().hasAll(['wishId', 'beneficiaryId', 'claimedBy',
                                                    'status', 'claimedAt', 'updatedAt'])
            && request.resource.data.wishId is string
            && request.resource.data.claimedBy is string
            && claimId == request.resource.data.wishId + '_' + request.resource.data.claimedBy
            && request.resource.data.status == 'reserved'
            && request.resource.data.claimedAt == request.time
            && request.resource.data.updatedAt == request.time
            // `beneficiaryId` dénormalisé, cohérent avec le souhait (sert aux requêtes).
            && request.resource.data.beneficiaryId == wish(request.resource.data.wishId).beneficiaryId
            && wish(request.resource.data.wishId).deleted == false
            // Jamais sur sa propre liste, et seulement par un participant de l'évènement.
            && request.resource.data.claimedBy != request.resource.data.beneficiaryId
            && request.resource.data.claimedBy in event().participantIds;
          allow update: if signedIn()
            && resource.data.claimedBy == me()
            && changedKeys().hasOnly(['status', 'updatedAt'])
            && request.resource.data.status in ['reserved', 'purchased']
            && request.resource.data.updatedAt == request.time;
          allow delete: if signedIn() && resource.data.claimedBy == me();
        }
      }
    }

    // Tout le reste est refusé par défaut.
  }
}
